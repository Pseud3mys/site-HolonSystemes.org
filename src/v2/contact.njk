---
layout: v2/base.njk
title: Contact
description: Contactez Holon Systems pour une démarche de concertation territoriale, une enquête interne ou un partenariat de terrain.
permalink: "{{ v2.base }}/contact/"
---

<section class="py-16 md:py-20">
    <p class="eyebrow mb-6">Contact</p>
    <h1 class="text-4xl md:text-5xl leading-tight max-w-4xl">Parlons de votre besoin.</h1>
    <p class="mt-8 max-w-3xl text-xl leading-relaxed">Quelques informations suffisent pour préparer un premier échange&nbsp;: votre structure, sa taille, la décision à éclairer et votre échéance.</p>
</section>

<section class="py-16 border-t border-gray-200">
    <div class="grid md:grid-cols-3 gap-12">

        <!-- Aide à la rédaction -->
        <aside class="md:col-span-1 space-y-6 text-base leading-relaxed">
            <div>
                <h2 class="text-2xl mb-3">Ce qui nous aide</h2>
                <ul class="check-list">
                    <li>Le nombre d'habitants, d'adhérents ou de salariés concernés.</li>
                    <li>Le sujet&nbsp;: un projet, une compétence, un document cadre.</li>
                    <li>L'échéance&nbsp;: un conseil, un vote du budget, un lancement de travaux.</li>
                    <li>Les publics que vous avez du mal à atteindre.</li>
                </ul>
            </div>
            <div>
                <p class="mb-2">Ou directement par e-mail&nbsp;:</p>
                <a href="mailto:{{ v2.email }}" class="link-underline">{{ v2.email }}</a>
            </div>
        </aside>

        <!-- Formulaire -->
        <form id="contactForm" class="md:col-span-2 bg-white/50 p-6 md:p-10 rounded-lg border border-gray-200">

            <div class="mb-6">
                <label for="subject" class="block text-lg font-bold mb-2">Vous êtes *</label>
                <select id="subject" name="subject" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--accent-color)] bg-white">
                    <option value="">-- Sélectionnez --</option>
                    <option value="Intercommunalité - projet de territoire, PPI, compétences" data-profil="interco">Une intercommunalité</option>
                    <option value="Commune - concertation municipale" data-profil="commune">Une commune</option>
                    <option value="Association - relais de terrain ou enquête interne" data-profil="association">Une association</option>
                    <option value="Entreprise - enquête interne, mobilité ou territoire" data-profil="entreprise">Une entreprise ou un club d'entreprises</option>
                    <option value="Plusieurs collectivités - enquête mutualisée" data-profil="mutualisation">Plusieurs collectivités qui veulent mutualiser</option>
                    <option value="Autre demande" data-profil="autre">Autre</option>
                </select>
            </div>

            <div class="grid sm:grid-cols-2 gap-6 mb-6">
                <div>
                    <label for="name" class="block text-lg font-bold mb-2">Nom complet *</label>
                    <input type="text" id="name" name="name" required autocomplete="name" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--accent-color)] bg-white" placeholder="Votre nom">
                </div>
                <div>
                    <label for="email" class="block text-lg font-bold mb-2">E-mail *</label>
                    <input type="email" id="email" name="email" required autocomplete="email" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--accent-color)] bg-white" placeholder="votre@email.fr">
                </div>
            </div>

            <div class="grid sm:grid-cols-2 gap-6 mb-6">
                <div>
                    <label for="organization" class="block text-lg font-bold mb-2">Structure</label>
                    <input type="text" id="organization" name="organization" autocomplete="organization" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--accent-color)] bg-white" placeholder="Commune, agglomération, association…">
                </div>
                <div>
                    <label for="role" class="block text-lg font-bold mb-2">Fonction</label>
                    <input type="text" id="role" name="role" autocomplete="organization-title" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--accent-color)] bg-white" placeholder="Élu, DGS, chargé de mission, DRH…">
                </div>
            </div>

            <div class="mb-6">
                <label for="size" class="block text-lg font-bold mb-2">Taille</label>
                <input type="text" id="size" name="size" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--accent-color)] bg-white" placeholder="Ex. 12 000 habitants, 25 communes, 350 adhérents, 250 salariés">
            </div>

            <div class="mb-6">
                <label for="message" class="block text-lg font-bold mb-2">Votre besoin *</label>
                <textarea id="message" name="message" rows="7" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--accent-color)] bg-white resize-y" placeholder="La décision à éclairer, le sujet, votre échéance, les publics que vous peinez à atteindre…"></textarea>
            </div>

            <div id="formMessage" class="mb-6 p-4 rounded-lg hidden" role="status"></div>

            <button type="submit" class="cta-button w-full md:w-auto px-8 py-4 text-lg">Envoyer</button>
        </form>
    </div>
</section>

<script>
// Pré-sélectionner le profil depuis l'URL (?profil=interco|commune|association|entreprise|mutualisation)
document.addEventListener('DOMContentLoaded', function() {
    const profil = new URLSearchParams(window.location.search).get('profil');
    if (!profil) return;
    const option = document.querySelector('#subject option[data-profil="' + profil + '"]');
    if (option) option.selected = true;
});

document.getElementById('contactForm').addEventListener('submit', async function(e) {
    e.preventDefault();

    // L'API attend name / email / organization / subject / message :
    // fonction et taille sont ajoutées en tête du message.
    const role = document.getElementById('role').value.trim();
    const size = document.getElementById('size').value.trim();
    const header = [
        role ? 'Fonction : ' + role : '',
        size ? 'Taille : ' + size : ''
    ].filter(Boolean).join('\n');
    const message = document.getElementById('message').value;

    const formData = {
        name: document.getElementById('name').value,
        email: document.getElementById('email').value,
        organization: document.getElementById('organization').value,
        subject: '[Site V2] ' + document.getElementById('subject').value,
        message: header ? header + '\n\n' + message : message
    };

    const messageDiv = document.getElementById('formMessage');
    const submitButton = e.target.querySelector('button[type="submit"]');

    submitButton.disabled = true;
    submitButton.textContent = 'Envoi en cours...';

    try {
        const response = await fetch('https://forms.holonsystems.org/submit', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(formData)
        });

        if (response.ok) {
            messageDiv.className = 'mb-6 p-4 rounded-lg bg-green-100 border border-green-400 text-green-700';
            messageDiv.textContent = 'Message envoyé. Nous revenons vers vous rapidement.';
            messageDiv.classList.remove('hidden');
            e.target.reset();
        } else {
            throw new Error('Erreur serveur');
        }
    } catch (error) {
        messageDiv.className = 'mb-6 p-4 rounded-lg bg-red-100 border border-red-400 text-red-700';
        messageDiv.textContent = 'Une erreur est survenue. Réessayez ou écrivez-nous directement par e-mail.';
        messageDiv.classList.remove('hidden');
    } finally {
        submitButton.disabled = false;
        submitButton.textContent = 'Envoyer';
    }
});
</script>

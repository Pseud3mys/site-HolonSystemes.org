---
layout: v2/base.njk
---
<article class="py-12 md:py-16">

    <!-- En-tête de l'article -->
    <header class="mb-12 max-w-3xl mx-auto">
        <p class="eyebrow mb-4">Blog · {{ page.date | dateToShort }}</p>
        <h1 class="text-4xl md:text-5xl leading-tight">{{ title }}</h1>
        {% if tags and tags.length > 0 %}
        <div class="mt-6 flex flex-wrap gap-2">
            {% for tag in tags %}
            <span class="tag-badge">{{ tag }}</span>
            {% endfor %}
        </div>
        {% endif %}
    </header>

    {% if image %}
    <div class="mb-12">
        <img src="{{ image }}" alt="{{ title }}" class="rounded-lg w-full max-w-4xl mx-auto">
    </div>
    {% endif %}

    <!-- Contenu de l'article -->
    <div class="article-content max-w-3xl mx-auto">
        {{ content | safe }}
    </div>

</article>

<div class="text-center py-16 border-t border-gray-200">
    <a href="/blog/" class="link-underline text-xl">← Retour au blog</a>
</div>
